# Copy to .env and fill.

# --- LLM: Amazon Bedrock (OpenAI-compatible) — recommended ---
LLM_PROVIDER=bedrock
OPENAI_API_KEY=your-amazon-bedrock-api-key
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_MODEL=openai.gpt-oss-20b-1:0
# Larger model: openai.gpt-oss-120b-1:0

# --- LLM: direct OpenAI API (alternative) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Leave OPENAI_BASE_URL unset for api.openai.com

# Optional: Excel file to append rows to (Teams/OneDrive path on your PC)
# LEADS_XLSX_PATH=C:\Users\You\OneDrive\...\YourLeads.xlsx
